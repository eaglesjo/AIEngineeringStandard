{
  "id": "codingstandard",
  "profile_version": 1,
  "project_type": "developer-standard",
  "architecture_profile": "repository-standard",
  "policy_profile": "repository-default",
  "runtime": {
    "os": ["linux", "macos", "windows"],
    "reference": "ubuntu-24.04",
    "python": "3.11+"
  },
  "delivery": {
    "validation_required": true,
    "release_from": "codingStandard-dev"
  },
  "scalability": {
    "traffic": "low-to-medium",
    "compute": "cpu-first",
    "state": "stateless-preferred",
    "async_work": "optional",
    "observability": "ci-and-validation"
  }
}
