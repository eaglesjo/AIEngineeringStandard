{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/eaglesjo/AIEngineeringStandard/blob/main/core/runtime/execution/mission.schema.json",
  "title": "AI Engineering Standard Execution Mission",
  "description": "Bounded repository execution contract for sandbox or GitHub Actions execution.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "repository",
    "source_sha",
    "purpose",
    "inputs",
    "operations",
    "expected_outputs",
    "permissions",
    "terminal_state",
    "verification",
    "capability_inventory",
    "lifecycle",
    "remote_state"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "repository": {
      "type": "string",
      "pattern": "^[^/\\\\s]+/[^/\\\\s]+$"
    },
    "source_sha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "purpose": {
      "type": "string",
      "minLength": 1
    },
    "inputs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "operations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "expected_outputs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "permissions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contents"
      ],
      "properties": {
        "contents": {
          "enum": [
            "none",
            "read",
            "write"
          ]
        },
        "actions": {
          "enum": [
            "none",
            "read",
            "write"
          ]
        },
        "pull_requests": {
          "enum": [
            "none",
            "read",
            "write"
          ]
        }
      }
    },
    "terminal_state": {
      "enum": [
        "SUCCEEDED",
        "FAILED",
        "BLOCKED",
        "CANCELLED"
      ]
    },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_sha",
        "outputs"
      ],
      "properties": {
        "source_sha": {
          "const": true
        },
        "outputs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "capability_inventory": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sandbox_capabilities",
        "required_capabilities",
        "decision"
      ],
      "properties": {
        "sandbox_capabilities": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "required_capabilities": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "decision": {
          "enum": [
            "REUSE_SANDBOX",
            "USE_ACTIONS",
            "BLOCKED"
          ]
        }
      }
    },
    "transport": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "checksum_algorithm",
        "expected_checksum",
        "verify_source_tree"
      ],
      "properties": {
        "mode": {
          "enum": [
            "DIRECT_TEXT",
            "DIRECT_FILE",
            "GIT_OBJECT",
            "BUNDLE",
            "ARCHIVE",
            "ARTIFACT"
          ]
        },
        "checksum_algorithm": {
          "enum": [
            "SHA-256",
            "SHA-512"
          ]
        },
        "expected_checksum": {
          "type": "string",
          "pattern": "^[0-9a-fA-F]{64,128}$"
        },
        "verify_source_tree": {
          "const": true
        }
      }
    },
    "lifecycle": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "phase",
        "evidence_inspected",
        "outputs_verified",
        "durable_result"
      ],
      "properties": {
        "phase": {
          "enum": [
            "CREATED",
            "EXECUTING",
            "TERMINAL"
          ]
        },
        "evidence_inspected": {
          "type": "boolean"
        },
        "outputs_verified": {
          "type": "boolean"
        },
        "durable_result": {
          "type": "boolean"
        }
      }
    },
    "failure_classification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "class",
        "retryable"
      ],
      "properties": {
        "class": {
          "enum": [
            "SOURCE_TEST",
            "MISSION_DEFECT",
            "PERMISSION_AUTH",
            "QUOTA_PLATFORM",
            "STALE_SOURCE",
            "TRANSIENT_INFRASTRUCTURE"
          ]
        },
        "retryable": {
          "type": "boolean"
        },
        "reason": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "remote_state": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "resources",
        "ownership",
        "cleanup"
      ],
      "properties": {
        "resources": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "ownership": {
          "enum": [
            "TASK_OWNED",
            "SHARED",
            "UNKNOWN"
          ]
        },
        "cleanup": {
          "enum": [
            "NOT_REQUIRED",
            "PENDING",
            "COMPLETED",
            "BLOCKED"
          ]
        }
      }
    }
  }
}
