{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://github.com/eaglesjo/AIEngineeringStandard/blob/main/core/contracts/2.1/handoff.schema.json","title":"AI Engineering Standard 2.1 Handoff Contract","type":"object","required":["schema_version","id","work_unit_id","sender","receiver","payload_ref","evidence_refs","reason","timestamp"],"properties":{"schema_version":{"const":"2.1.0"},"id":{"type":"string","pattern":"^[a-z0-9][a-z0-9._-]*$"},"work_unit_id":{"type":"string","minLength":1},"sender":{"type":"string","minLength":1},"receiver":{"type":"string","minLength":1},"payload_ref":{"type":"string","minLength":1},"evidence_refs":{"type":"array","items":{"type":"string","minLength":1},"minItems":1},"reason":{"type":"string","minLength":1},"timestamp":{"type":"string","format":"date-time"}},"additionalProperties":false}