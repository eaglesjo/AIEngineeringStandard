{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://github.com/eaglesjo/AIEngineeringStandard/blob/main/core/contracts/2.1/evaluation.schema.json","title":"AI Engineering Standard 2.1 Evaluation and Acceptance Contract","type":"object","required":["schema_version","id","work_unit_id","criteria","evidence_refs","result","acceptance"],"properties":{"schema_version":{"const":"2.1.0"},"id":{"type":"string","pattern":"^[a-z0-9][a-z0-9._-]*$"},"work_unit_id":{"type":"string","minLength":1},"criteria":{"type":"array","items":{"type":"string","minLength":1},"minItems":1},"evidence_refs":{"type":"array","items":{"type":"string","minLength":1},"minItems":1},"result":{"type":"string","enum":["PASS","PARTIAL","UNTESTED","BLOCKED","FAIL"]},"acceptance":{"type":"object","required":["status","basis"],"properties":{"status":{"type":"string","enum":["ACCEPTED","REJECTED","INCOMPLETE"]},"basis":{"type":"string","minLength":1}},"additionalProperties":false}},"allOf":[{"if":{"properties":{"result":{"enum":["FAIL","UNTESTED","BLOCKED"]}},"required":["result"]},"then":{"properties":{"acceptance":{"properties":{"status":{"not":{"const":"ACCEPTED"}}}}}}}],"additionalProperties":false}