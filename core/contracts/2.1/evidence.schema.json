{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://github.com/eaglesjo/AIEngineeringStandard/blob/main/core/contracts/2.1/evidence.schema.json","title":"AI Engineering Standard 2.1 Evidence Contract","type":"object","required":["schema_version","id","work_unit_id","source","type","reference","method","trust"],"properties":{"schema_version":{"const":"2.1.0"},"id":{"type":"string","pattern":"^[a-z0-9][a-z0-9._-]*$"},"work_unit_id":{"type":"string","minLength":1},"source":{"type":"string","minLength":1},"type":{"type":"string","enum":["artifact","observation","test-result","log","human-approval"]},"reference":{"type":"string","minLength":1},"digest":{"type":["string","null"]},"method":{"type":"string","minLength":1},"trust":{"type":"string","enum":["UNTRUSTED","REVIEWED","VERIFIED"]}},"additionalProperties":false}