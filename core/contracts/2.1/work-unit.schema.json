{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/eaglesjo/AIEngineeringStandard/blob/main/core/contracts/2.1/work-unit.schema.json",
  "title": "AI Engineering Standard 2.1 Work Unit Contract",
  "type": "object",
  "required": [
    "schema_version",
    "id",
    "objective",
    "owner",
    "status",
    "acceptance_criteria"
  ],
  "properties": {
    "schema_version": {
      "const": "2.1.0"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]*$"
    },
    "parent_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "objective": {
      "type": "string",
      "minLength": 1
    },
    "owner": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "type": "string",
      "enum": [
        "CREATED",
        "READY",
        "EXECUTING",
        "HANDOFF_PENDING",
        "EVALUATING",
        "ACCEPTED",
        "BLOCKED",
        "RETRY",
        "REJECTED"
      ]
    },
    "input_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "output_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "retry_reason": {
      "type": [
        "string",
        "null"
      ]
    },
    "failure_evidence_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "acceptance_criteria": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1
    }
  },
  "additionalProperties": false
}
