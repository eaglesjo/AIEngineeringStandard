{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/eaglesjo/AIEngineeringStandard/blob/main/core/validation/ai-evaluation.schema.json",
  "title": "AI Engineering Standard 2.0 AI Evaluation Evidence",
  "type": "object",
  "required": ["schema_version", "task_id", "evaluation", "cases", "acceptance"],
  "properties": {
    "schema_version": {"type": "string", "const": "2.0.0"},
    "task_id": {"type": "string", "minLength": 1},
    "evaluation": {
      "type": "object",
      "required": ["method", "deterministic"],
      "properties": {
        "method": {"type": "string", "const": "deterministic"},
        "deterministic": {"type": "boolean", "const": true}
      },
      "additionalProperties": false
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "input", "expected_criteria", "score", "evidence"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "input": {"type": "string", "minLength": 1},
          "expected_criteria": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["id", "result", "evidence"],
              "properties": {
                "id": {"type": "string", "minLength": 1},
                "result": {"type": "string", "enum": ["PASS", "FAIL"]},
                "evidence": {"type": "string", "minLength": 1}
              },
              "additionalProperties": false
            }
          },
          "score": {"type": "number", "minimum": 0, "maximum": 1},
          "evidence": {"type": "string", "minLength": 1}
        },
        "additionalProperties": false
      }
    },
    "acceptance": {
      "type": "object",
      "required": ["status", "threshold", "basis"],
      "properties": {
        "status": {"type": "string", "enum": ["ACCEPTED", "REJECTED", "INCOMPLETE"]},
        "threshold": {"type": "number", "minimum": 0, "maximum": 1},
        "basis": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
