{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/eaglesjo/AIEngineeringStandard/blob/main/core/validation/conformance-evidence.schema.json",
  "title": "AIEngineeringStandard 2.0 Runtime Conformance Evidence",
  "type": "object",
  "required": ["schema_version", "standard_version", "agent", "runtime", "repository", "scenario", "started_at", "finished_at", "result", "observations", "checks"],
  "properties": {
    "schema_version": {"type": "string", "const": "2.0.0"},
    "standard_version": {"type": "string", "pattern": "^2\\.[0-9]+$"},
    "agent": {"type": "string", "minLength": 1},
    "runtime": {
      "type": "object",
      "required": ["version", "invocation"],
      "properties": {
        "version": {"type": ["string", "null"]},
        "invocation": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "repository": {
      "type": "object",
      "required": ["revision"],
      "properties": {
        "revision": {"type": ["string", "null"]},
        "dirty": {"type": ["boolean", "null"]}
      },
      "additionalProperties": false
    },
    "scenario": {
      "type": "object",
      "required": ["id", "description"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "description": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "started_at": {"type": "string", "format": "date-time"},
    "finished_at": {"type": "string", "format": "date-time"},
    "result": {"type": "string", "enum": ["PASS", "PARTIAL", "ADAPTER", "UNTESTED", "UNSUPPORTED", "FAIL"]},
    "exit_code": {"type": ["integer", "null"]},
    "timed_out": {"type": "boolean"},
    "stdout_excerpt": {"type": "string"},
    "stderr_excerpt": {"type": "string"},
    "observations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "source", "result", "details"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "source": {"type": "string", "enum": ["harness", "adapter", "runtime"]},
          "result": {"type": "string", "enum": ["OBSERVED", "NOT_OBSERVED", "FAILED"]},
          "details": {"type": "string", "minLength": 1}
        },
        "additionalProperties": false
      }
    },
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "result", "evidence"],
        "properties": {
          "id": {"type": "string", "enum": ["instruction-discovery", "skill-discovery", "skill-loading", "plugin-capability", "mcp-capability", "permission-check", "task-execution", "validation", "failure-recovery", "evidence-reporting"]},
          "result": {"type": "string", "enum": ["PASS", "PARTIAL", "ADAPTER", "UNTESTED", "UNSUPPORTED", "FAIL"]},
          "evidence": {"type": "string", "minLength": 1},
          "notes": {"type": "string"}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
