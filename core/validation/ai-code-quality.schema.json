{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/eaglesjo/AIEngineeringStandard/blob/main/core/validation/ai-code-quality.schema.json",
  "title": "AI Engineering Standard 2.0 AI Code Quality Evidence",
  "type": "object",
  "required": ["schema_version", "task_id", "candidate", "checks", "acceptance"],
  "properties": {
    "schema_version": {"type": "string", "const": "2.0.0"},
    "task_id": {"type": "string", "minLength": 1},
    "candidate": {
      "type": "object",
      "required": ["revision", "dirty"],
      "properties": {
        "revision": {"type": "string", "minLength": 1},
        "dirty": {"type": "boolean"}
      },
      "additionalProperties": false
    },
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "result", "evidence"],
        "properties": {
          "id": {"type": "string", "enum": ["scope", "focused_test", "quality_check", "broader_validation", "review"]},
          "result": {"type": "string", "enum": ["PASS", "FAIL", "NOT_RUN"]},
          "evidence": {"type": "string", "minLength": 1}
        },
        "additionalProperties": false
      }
    },
    "acceptance": {
      "type": "object",
      "required": ["status", "basis"],
      "properties": {
        "status": {"type": "string", "enum": ["ACCEPTED", "REJECTED", "INCOMPLETE"]},
        "basis": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
