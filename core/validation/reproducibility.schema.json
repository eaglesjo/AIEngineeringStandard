{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/eaglesjo/AIEngineeringStandard/blob/main/core/validation/reproducibility.schema.json",
  "title": "AI Engineering Standard 2.0 Reproducibility Evidence",
  "type": "object",
  "required": ["schema_version", "task_id", "experiment", "artifacts", "acceptance"],
  "properties": {
    "schema_version": {"type": "string", "const": "2.0.0"},
    "task_id": {"type": "string", "minLength": 1},
    "experiment": {
      "type": "object",
      "required": ["experiment_id", "variant", "seed", "config_hash", "git_revision", "dirty"],
      "properties": {
        "experiment_id": {"type": "string", "minLength": 1},
        "variant": {"type": "string", "minLength": 1},
        "seed": {"type": "integer"},
        "config_hash": {"type": "string", "pattern": "^[0-9a-f]{16,64}$"},
        "model_revision": {"type": ["string", "null"]},
        "dataset_revision": {"type": ["string", "null"]},
        "environment_profile": {"type": ["string", "null"]},
        "git_revision": {"type": "string", "minLength": 7},
        "dirty": {"type": "boolean"}
      },
      "additionalProperties": false
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "kind", "sha256", "source"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "kind": {"type": "string", "enum": ["input", "output", "model", "dataset", "config", "environment"]},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "source": {"type": "string", "minLength": 1},
          "revision": {"type": ["string", "null"]}
        },
        "additionalProperties": false
      }
    },
    "acceptance": {
      "type": "object",
      "required": ["status", "basis"],
      "properties": {
        "status": {"type": "string", "enum": ["REPRODUCIBLE", "NOT_REPRODUCIBLE", "INCOMPLETE"]},
        "basis": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
