{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/eaglesjo/AIEngineeringStandard/blob/main/core/validation/conformance-result.schema.json",
  "title": "AIEngineeringStandard 2.0 Conformance Result",
  "type": "object",
  "required": ["schema_version", "standard_version", "agent", "tested_at", "result", "checks"],
  "properties": {
    "schema_version": {"type": "string", "const": "2.0.0"},
    "standard_version": {"type": "string", "pattern": "^2\\.[0-9]+$"},
    "agent": {"type": "string", "minLength": 1},
    "runtime_version": {"type": ["string", "null"]},
    "tested_at": {"type": "string", "format": "date-time"},
    "result": {"type": "string", "enum": ["PASS", "PARTIAL", "ADAPTER", "UNTESTED", "UNSUPPORTED", "FAIL"]},
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "result"],
        "properties": {
          "id": {"type": "string", "enum": ["instruction-discovery", "skill-discovery", "skill-loading", "plugin-capability", "mcp-capability", "permission-check", "task-execution", "validation", "failure-recovery", "evidence-reporting"]},
          "result": {"type": "string", "enum": ["PASS", "PARTIAL", "ADAPTER", "UNTESTED", "UNSUPPORTED", "FAIL"]},
          "evidence": {"type": "string"},
          "notes": {"type": "string"}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
